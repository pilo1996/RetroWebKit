#include "../../../../../Internal/Configurations/HaveInternalSDK.xcconfig"

USE_INTERNAL_SDK = $(USE_INTERNAL_SDK_$(CONFIGURATION));
USE_INTERNAL_SDK_Production = YES;
USE_INTERNAL_SDK_Debug = $(HAVE_INTERNAL_SDK);
USE_INTERNAL_SDK_Release = $(HAVE_INTERNAL_SDK);

TARGET_GCC_VERSION = $(TARGET_GCC_VERSION_$(PLATFORM_NAME));
TARGET_GCC_VERSION_macosx = $(TARGET_GCC_VERSION_macosx_$(TARGET_MAC_OS_X_VERSION_MAJOR));
TARGET_GCC_VERSION_macosx_1050 = GCC_50;
TARGET_GCC_VERSION_macosx_1060 = GCC_50;
TARGET_GCC_VERSION_macosx_1070 = LLVM_COMPILER;
TARGET_GCC_VERSION_macosx_1080 = LLVM_COMPILER;
TARGET_GCC_VERSION_macosx_1090 = LLVM_COMPILER;

GCC_VERSION = $(GCC_VERSION_$(TARGET_GCC_VERSION));
GCC_VERSION_GCC_40 = 4.0;
GCC_VERSION_GCC_42 = 4.2;
GCC_VERSION_GCC_49 = 4.9;
GCC_VERSION_GCC_50 = 5.0;
GCC_VERSION_LLVM_COMPILER = com.apple.compilers.llvm.clang.1_0;

CLANG_CXX_LANGUAGE_STANDARD = gnu++14;
CLANG_CXX_LIBRARY = libc++;
CLANG_WARN_BOOL_CONVERSION = YES;
CLANG_WARN_CONSTANT_CONVERSION = YES;
CLANG_WARN_EMPTY_BODY = YES;
CLANG_WARN_ENUM_CONVERSION = YES;
CLANG_WARN_INT_CONVERSION = YES;
CLANG_WARN__DUPLICATE_METHOD_MATCH = YES;
DEAD_CODE_STRIPPING = YES;
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym;
GCC_CXX_LANGUAGE_STANDARD = gnu++14;
GCC_C_LANGUAGE_STANDARD = gnu99;
GCC_DEBUGGING_SYMBOLS = default;
GCC_ENABLE_CPP_EXCEPTIONS = NO;
GCC_ENABLE_CPP_RTTI = NO;
GCC_ENABLE_OBJC_EXCEPTIONS = YES;
ENABLE_STRICT_OBJC_MSGSEND = YES;
GCC_ENABLE_OBJC_GC = $(GCC_ENABLE_OBJC_GC_$(PLATFORM_NAME));
GCC_ENABLE_OBJC_GC_macosx = supported;
GCC_ENABLE_SYMBOL_SEPARATION = NO;
GCC_FAST_OBJC_DISPATCH = YES;
GCC_INLINES_ARE_PRIVATE_EXTERN = YES;
GCC_NO_COMMON_BLOCKS = YES;
GCC_MODEL_TUNING = $(GCC_MODEL_TUNING_$(PLATFORM_NAME)_$(CURRENT_ARCH));
GCC_MODEL_TUNING_macosx_ppc64 = G5;
GCC_MODEL_TUNING_macosx_ppc = G5;
GCC_MODEL_TUNING_macosx_ppc970 = 970;
GCC_MODEL_TUNING_macosx_ppc7400 = 7450;
GCC_MODEL_CPU = $(GCC_MODEL_CPU_$(PLATFORM_NAME));
GCC_MODEL_CPU_macosx = $(GCC_MODEL_CPU_macosx_$(CURRENT_ARCH));
GCC_MODEL_CPU_macosx_ppc64 = 970;
GCC_MODEL_PPC64 = $(GCC_MODEL_PPC64_$(PLATFORM_NAME)_$(CURRENT_ARCH));
GCC_MODEL_PPC64_macosx_ppc970 = YES;
GCC_MODEL_PPC64_macosx_ppc64 = YES;
GCC_OBJC_CALL_CXX_CDTORS = YES;
GCC_OPTIMIZATION_LEVEL = s;
GCC_PRECOMPILE_PREFIX_HEADER = NO;
GCC_SYMBOLS_PRIVATE_EXTERN = YES;
GCC_THREADSAFE_STATICS = NO;
GCC_TREAT_WARNINGS_AS_ERRORS = YES;
GCC_WARN_64_TO_32_BIT_CONVERSION = YES;
GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS = NO;
GCC_WARN_ABOUT_MISSING_NEWLINE = YES;
GCC_WARN_ABOUT_RETURN_TYPE = YES;
GCC_WARN_UNDECLARED_SELECTOR = YES;
GCC_WARN_UNINITIALIZED_AUTOS = NO;
GCC_WARN_UNUSED_FUNCTION = NO;
GCC_WARN_UNUSED_VARIABLE = YES;
PREBINDING = NO;
STRIP_INSTALLED_PRODUCT = NO;

SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx appletvos appletvsimulator watchos watchsimulator;

TARGET_MAC_OS_X_VERSION_MAJOR = $(TARGET_MAC_OS_X_VERSION_MAJOR$(MACOSX_DEPLOYMENT_TARGET:suffix:identifier));
TARGET_MAC_OS_X_VERSION_MAJOR_10 = 101000;
TARGET_MAC_OS_X_VERSION_MAJOR_11 = 101100;
TARGET_MAC_OS_X_VERSION_MAJOR_12 = 101200;
TARGET_MAC_OS_X_VERSION_MAJOR_13 = 101300;

SDKROOT = macosx.internal;

OTHER_CFLAGS = $(ASAN_OTHER_CFLAGS);
OTHER_CPLUSPLUSFLAGS = $(ASAN_OTHER_CPLUSPLUSFLAGS);
OTHER_LDFLAGS = $(ASAN_OTHER_LDFLAGS);

USER_HEADER_SEARCH_PATHS = $(BUILT_PRODUCTS_DIR)/usr/local/include $(BUILT_PRODUCTS_DIR)/usr/local/include/lz4 $(USER_HEADER_SEARCH_PATHS);

GCC_PREPROCESSOR_DEFINITIONS = HAVE_CORETEXT $(GCC_PREPROCESSOR_DEFINITIONS_$(PLATFORM_NAME));
GCC_PREPROCESSOR_DEFINITIONS_macosx = $(GCC_PREPROCESSOR_DEFINITIONS_macosx_$(TARGET_MAC_OS_X_VERSION_MAJOR));
GCC_PREPROCESSOR_DEFINITIONS_macosx_1050 = ;
GCC_PREPROCESSOR_DEFINITIONS_macosx_1060 = OTS_GRAPHITE;
GCC_PREPROCESSOR_DEFINITIONS_macosx_1070 = OTS_GRAPHITE;
GCC_PREPROCESSOR_DEFINITIONS_macosx_1080 = OTS_GRAPHITE;
GCC_PREPROCESSOR_DEFINITIONS_macosx_1090 = OTS_GRAPHITE;
