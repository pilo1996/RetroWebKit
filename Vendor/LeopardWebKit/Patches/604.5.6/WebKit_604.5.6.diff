+        //  lis r0, HI(target)
+        //  b <trampoline>
+        // [...]
+        // trampoline:
+        //  ori r0, LO(target)
+        //  mtctr r0
+        //  bctr
+        // On G5, it is simpler:
+        //   trap
+        //   0 (yes, 32 bits of zeros)
+        //   the branch _code_ offset (NOT the relative offset) as a int32_t
+        //   b[c]ctr[l]
+        // and then at executableCopy() time we will repatch the stanza to
+        // the proper lis,ori,mtctr,b[c]ctr[l] form.
+
+        Jumps m_largeJumps;
+    }; // class PPCAssembler
+
+} // namespace JSC
