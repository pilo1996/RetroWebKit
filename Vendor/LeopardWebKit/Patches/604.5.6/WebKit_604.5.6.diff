+++ b/Source/ThirdParty/lz4/Makefile
@@ -0,0 +1,183 @@
+include ../Makefile.shared
+
+# ################################################################
+# LZ4 - Makefile
+# Copyright (C) Yann Collet 2011-2016
+# All rights reserved.
+#
+# This Makefile is validated for Linux, macOS, *BSD, Hurd, Solaris, MSYS2 targets
